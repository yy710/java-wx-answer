<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.web.mapper.RewardClaimMapper">
    <select id="selectForUpdate" resultType="com.yunkesoftware.www.web.entity.RewardClaim">
        SELECT * FROM reward_claims WHERE user_id = #{userId} AND event_id = #{eventId} LIMIT 1 FOR UPDATE
    </select>
</mapper>
