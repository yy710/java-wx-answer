<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.web.mapper.TopicLineTopicMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yunkesoftware.www.web.entity.TopicLineTopic">
        <result column="topic_line_id" property="topicLineId" />
        <result column="topic_id" property="topicId" />
        <result column="reward_amount" property="rewardAmount" />
        <result column="seq" property="seq" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        topic_line_id, topic_id, reward_amount, seq
    </sql>
    <select id="listByTopicLineId" resultType="com.yunkesoftware.www.web.entity.Topic">
        SELECT tlt.reward_amount,
               t.id,
               t.title
        FROM topic_line_topic tlt
                 LEFT JOIN topic t ON tlt.topic_id = t.id
        WHERE tlt.topic_line_id = #{topicLineId}
        ORDER BY tlt.seq ASC
    </select>

</mapper>
