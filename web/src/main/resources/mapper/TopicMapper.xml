<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.web.mapper.TopicMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yunkesoftware.www.web.entity.Topic">
        <id column="id" property="id" />
        <result column="title" property="title" />
        <result column="reward_amount" property="rewardAmount" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, title, reward_amount,
    </sql>
    <select id="listNewOrWrong" resultType="com.yunkesoftware.www.web.entity.Topic">
        SELECT id, title, reward_amount
        FROM topic t
        <if test="rightIds != null and rightIds.size()>0">
            WHERE id NOT IN
            <foreach item="item" collection="rightIds" index="index" separator="," open="(" close=")">
                #{item}
            </foreach>
        </if>
        ORDER BY RAND()
        LIMIT #{topicNum}
    </select>
    <select id="listRight" resultType="com.yunkesoftware.www.web.entity.Topic">
        SELECT id, title, reward_amount
        FROM topic 
        WHERE id IN
        <foreach item="item" collection="rightIds" index="index" separator="," open="(" close=")">
            #{item}
        </foreach>
        ORDER BY RAND()
        LIMIT #{topicNum}
    </select>


</mapper>
