<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.web.mapper.VideoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yunkesoftware.www.web.entity.Video">
        <id column="id" property="id" />
        <result column="title" property="title" />
        <result column="descr" property="descr" />
        <result column="status" property="status" />
        <result column="url_video" property="urlVideo" />
        <result column="url_pic" property="urlPic" />
        <result column="seq" property="seq" />
        <result column="ticket_total" property="ticketTotal" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, title, descr, status, url_video, url_pic, seq, ticket_total, create_time, update_time
    </sql>

</mapper>
