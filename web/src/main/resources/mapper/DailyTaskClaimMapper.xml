<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.web.mapper.DailyTaskClaimMapper">
    <select id="selectByUserDateType" resultType="com.yunkesoftware.www.web.entity.DailyTaskClaim">
        SELECT * FROM daily_task_claim WHERE user_id = #{userId} AND task_date = #{taskDate} AND task_type = #{taskType} LIMIT 1
    </select>
</mapper>
