<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.web.mapper.TopicRecordSingleMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yunkesoftware.www.web.entity.TopicRecordSingle">
        <id column="id" property="id" />
        <result column="topic_id" property="topicId" />
        <result column="topic_title" property="topicTitle" />
        <result column="user_id" property="userId" />
        <result column="right_flag" property="rightFlag" />
        <result column="reward_amount" property="rewardAmount" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, topic_id, topic_title, user_id, right_flag, reward_amount, create_time
    </sql>
    <select id="listRightTopicId" resultType="java.lang.String">
        SELECT topic_id FROM topic_record_single WHERE right_flag = 1 AND user_id = #{userId}
    </select>

</mapper>
