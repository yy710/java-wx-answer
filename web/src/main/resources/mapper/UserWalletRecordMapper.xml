<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.web.mapper.UserWalletRecordMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yunkesoftware.www.web.entity.UserWalletRecord">
        <id column="id" property="id" />
        <result column="wallet_id" property="walletId" />
        <result column="change_amount" property="changeAmount" />
        <result column="after_amount" property="afterAmount" />
        <result column="event_id" property="eventId" />
        <result column="event_type" property="eventType" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, wallet_id, change_amount, after_amount, event_id, event_type, status, create_time
    </sql>
    <select id="countTodayNum" resultType="java.lang.Integer">
        SELECT count(1) FROM user_wallet_record
        WHERE wallet_id=#{walletId} AND event_type=#{eventType} AND DATE_FORMAT(create_time,'%Y-%m-%d') = #{dateParam}
    </select>

</mapper>
