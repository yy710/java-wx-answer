<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.adm.mapper.TopicLineTopicMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yunkesoftware.www.adm.entity.TopicLineTopic">
        <result column="topic_line_id" property="topicLineId" />
        <result column="topic_id" property="topicId" />
        <result column="reward_amount" property="rewardAmount" />
        <result column="seq" property="seq" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, topic_line_id, topic_id, reward_amount, seq
    </sql>
    <insert id="insertBatch">
        INSERT INTO topic_line_topic (topic_line_id, topic_id, reward_amount, seq) VALUES
        <foreach collection="dataList" item="item" separator=",">
            (#{item.topicLineId}, #{item.topicId}, #{item.rewardAmount}, #{item.seq})
        </foreach>
    </insert>

</mapper>
