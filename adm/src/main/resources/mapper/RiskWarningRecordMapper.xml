<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.adm.mapper.RiskWarningRecordMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yunkesoftware.www.adm.entity.RiskWarningRecord">
        <result column="risk_warn_id" property="riskWarnId" />
        <result column="user_id" property="userId" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        risk_warn_id, user_id, create_time
    </sql>
    <select id="pageByQuery" resultType="com.yunkesoftware.www.adm.entity.RiskWarningRecord">
        SELECT
            rwr.create_time,
            rwr.risk_warn_id,
            rwr.user_id,
            yu.nick_name
        FROM risk_warning_record rwr
        LEFT JOIN yk_user yu ON rwr.user_id = yu.id
        WHERE rwr.risk_warn_id = #{param.riskWarnId}
        <if test="param.nickName != null and param.nickName != ''">
            AND yu.nick_name LIKE CONCAT('%',#{param.nickName},'%')
        </if>
        ORDER BY rwr.create_time DESC
    </select>

</mapper>
