<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.adm.mapper.RiskWarningMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yunkesoftware.www.adm.entity.RiskWarning">
        <id column="id" property="id" />
        <result column="title" property="title" />
        <result column="reward_amount" property="rewardAmount" />
        <result column="status" property="status" />
        <result column="seq" property="seq" />
        <result column="view_num" property="viewNum" />
        <result column="descr" property="descr" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, title, reward_amount, status, seq, view_num, descr, create_time, update_time
    </sql>
    <select id="pageByQuery" resultType="com.yunkesoftware.www.adm.entity.RiskWarning">
        SELECT
        rw.id,
        rw.title,
        rw.reward_amount,
        rw.category_id,
        rw.status,
        rw.seq,
        rw.view_num,
        rw.descr,
        c.title AS categoryTitle
        FROM risk_warning rw
        LEFT JOIN category c ON rw.category_id = c.id
        <where>
            <if test="param.title != null and param.title != ''">
                AND rw.title LIKE CONCAT('%',#{param.title},'%')
            </if>
        </where>
        ORDER BY rw.seq ASC
    </select>

</mapper>
