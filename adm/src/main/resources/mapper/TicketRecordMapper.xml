<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunkesoftware.www.adm.mapper.TicketRecordMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yunkesoftware.www.adm.entity.TicketRecord">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="ticket_activity_id" property="ticketActivityId" />
        <result column="ticket_video_id" property="ticketVideoId" />
        <result column="ip_addr" property="ipAddr" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, user_id, ticket_activity_id, ticket_video_id, ip_addr, create_time
    </sql>
    <select id="pageByQuery" resultType="com.yunkesoftware.www.adm.entity.TicketRecord">
        SELECT
        tr.id,
        tr.ip_addr,
        tr.create_time,
        yu.nick_name
        FROM ticket_record tr
        LEFT JOIN yk_user yu ON yu.id = tr.user_id
        <where>
            <if test="param.ticketActivityId != null and param.ticketActivityId != ''">
                AND tr.ticket_activity_id = #{param.ticketActivityId}
            </if>
            <if test="param.ticketVideoId != null and param.ticketVideoId != ''">
                AND tr.ticket_video_id = #{param.ticketVideoId}
            </if>
        </where>
        ORDER BY tr.id DESC
    </select>

</mapper>
